{
  "manifest_version": 2,
  "name": "Custom Presence",
  "version": "0.3.0",
  "description": "Tells the Custom Presence BetterDiscord plugin what YouTube, YouTube Music and Twitch tabs are playing.",
  "browser_specific_settings": {
    "gecko": { "id": "custom-presence@therealestnwah" }
  },
  "permissions": ["nativeMessaging", "tabs"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://music.youtube.com/*", "*://*.twitch.tv/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
